# ===========================================
# VitaProd Bot Configuration
# ===========================================
# Скопируйте этот файл в .env и заполните своими данными
# cp .env.example .env
# ===========================================

# Telegram Bot
# Получить: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram IDs менеджеров (через запятую)
# Узнать свой ID: https://t.me/userinfobot
MANAGER_TELEGRAM_IDS=123456789,987654321

# GigaChat API
# Получить: https://developers.sber.ru
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here

# Groq API (для голосовых сообщений) - БЕСПЛАТНО
# Получить: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# PostgreSQL (для памяти диалогов)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_db_name

# Qdrant (векторная база)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Контакты компании (для эскалации)
ESCALATION_PHONE=+7XXXXXXXXXX
ESCALATION_WHATSAPP=+7XXXXXXXXXX
ESCALATION_EMAIL=your_email@example.com

# Режим отладки (опционально)
# DEBUG=true
# LOG_LEVEL=INFO
